# Absolute site URL used for canonical, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://example.com

# Path prefix for GitHub project pages, for example /iskra. Leave empty locally.
NEXT_PUBLIC_BASE_PATH=

# Public web-gateway base URL (dating-bot). No secrets — APP token stays on gateway.
# Local: http://127.0.0.1:8001
# Prod: https://api.chatwithyou.site  (Cloudflare Access bypass for /api/v1/*)
NEXT_PUBLIC_CHAT_API_URL=http://127.0.0.1:8001
