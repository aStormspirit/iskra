# Absolute site URL used for canonical, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://example.com

# Path prefix for GitHub project pages, for example /iskra. Leave empty locally.
NEXT_PUBLIC_BASE_PATH=

# Chat API base URL: Cloudflare Worker from worker/ (route chatwithyou.site/api/*).
# No secrets here — tokens live in Worker secrets.
# Empty value uses https://chatwithyou.site.
# Local worker: http://127.0.0.1:8787 (cd worker && npm run dev)
NEXT_PUBLIC_CHAT_API_URL=https://chatwithyou.site
